{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "affiliates-manager",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Las Preview URLs no quedan protegidas al activar Cloudflare Access en workers.dev
  "preview_urls": false,
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "affiliates-manager",
      // Sustituir por el id que devuelve `wrangler d1 create affiliates-manager`
      "database_id": "3c0d496d-10de-45ea-b538-e34898634161",
      "migrations_dir": "server/db/migrations"
    }
  ],
  // Deben coincidir con `nitro.scheduledTasks` en nuxt.config.ts (UTC)
  "triggers": {
    "crons": ["0 5 * * *", "*/10 * * * *"]
  },
  "vars": {
    "TIMEZONE": "Europe/Madrid"
  }
}
