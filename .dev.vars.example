# Copia este fichero a .dev.vars para desarrollo local (wrangler lo lee automáticamente).
# En producción usa `wrangler secret put <NOMBRE>` para los secretos.

# Desactiva la validación de Cloudflare Access (solo se respeta en `nuxt dev`).
AUTH_DISABLED=true

# Cloudflare Access (producción)
# AUTH_TEAM_DOMAIN=mi-equipo.cloudflareaccess.com
# AUTH_AUDIENCE=<Application Audience (AUD) Tag>
# AUTH_ALLOWED_EMAILS=yo@example.com

# Telegram (secreto)
# TELEGRAM_BOT_TOKEN=123456:ABC...

# Bot buzón (SPEC §14.8): bot APARTE del que publica
# INTAKE_BOT_TOKEN=123456:XYZ...
# INTAKE_WEBHOOK_SECRET=una-cadena-aleatoria-larga
# INTAKE_ALLOWED_USER_IDS=111111111,222222222

# Amazon Creators API (docs/creators-api.md), credencial versión 3.2 de amazon.es
# CREATORS_CREDENTIAL_ID=amzn1.application-oa2-client.xxxx
# CREATORS_CREDENTIAL_SECRET=amzn1.oa2-cs.v1.xxxx
# CREATORS_PARTNER_TAG=mitienda-21
